{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "oxc"],
  "rules": {
    "complexity": ["warn", 20],
    "max-depth": ["warn", 4],
    "max-lines": [
      "warn",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["warn", 4],
    "no-var": "warn",
    "no-var-requires": "error",
    "typescript/no-import-type-side-effects": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/electron-active-hook*.cjs",
        "tests/conformance/readiness/electron/*.js",
        "website/public/examples/notes-electron/*.js"
      ],
      "rules": {
        "no-var-requires": "off"
      }
    },
    {
      "files": ["tests/**/*.ts", "src/**/*.test.ts", "src/**/*.fixture.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": [
          "error",
          {
            "max": 150,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["src/application/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/server/**", "**/cli.*", "**/main.*"],
                "message": "Service tests must use application ports rather than CLI or MCP entrypoints."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/composition/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/server/**",
                  "**/cli.*",
                  "**/main.*",
                  "node:child_process",
                  "node:net",
                  "node:http",
                  "node:https",
                  "ws",
                  "playwright"
                ],
                "message": "Composition tests may wire provider-neutral sessions but must not invoke CLI, MCP, process, network, or browser boundaries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "scripts/ci/workflow-run.mjs",
        "scripts/verify-package-setup.mjs",
        "src/application/SetupHost.ts",
        "src/application/SetupInstallFailure.ts",
        "src/artifacts/SafeOutputTree.ts",
        "src/contracts/fridaRemoteAddress.ts",
        "src/contracts/native/nativeToolContracts.ts",
        "src/domain/adb/adbDeviceAnalysis.ts",
        "src/domain/apple/dylibResolution.ts",
        "src/domain/javascript/electronActiveObservation.ts",
        "src/domain/localPath.ts",
        "src/domain/native/nativeCallObservation.ts",
        "src/domain/portableSchemaPatterns.test.ts",
        "src/domain/process/processScenario.ts",
        "src/domain/recordedTransportUrl.ts",
        "src/domain/reverseEngineering.ts",
        "src/evm/EvmBytecodeCarrier.ts",
        "src/flutter/FlutterPayloadScan.ts",
        "src/ida/IdaJsonDiagnostic.ts"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    },
    {
      "files": [
        "scripts/lib/browser-capture-metadata-budget-e2e.mjs",
        "scripts/lib/browser-scenario-service-worker-setup-e2e.mjs",
        "scripts/lib/browser-scenario-service-workers-e2e.mjs",
        "scripts/lib/real-ghidra-address-boundaries.mjs",
        "scripts/lib/real-ghidra-file-offsets.mjs",
        "scripts/verify-native-ui.mjs",
        "scripts/verify-real-ghidra-windows.mjs",
        "scripts/verify-real-ghidra.mjs",
        "scripts/verify-real-hopper-deadlines.mjs",
        "src/application/javascript/JavaScriptArtifactReconstruction.ts",
        "src/artifacts/readStableArtifact.ts",
        "src/cliBrowserScenarioCommands.ts",
        "src/process/HopperLease.ts",
        "src/process/LinuxResourceLimits.ts",
        "src/sqlite/SqliteDatabaseSnapshot.ts",
        "tests/acceptance/providers/hopperStartupRecovery.test.ts",
        "tests/boundary/filesystem/directAnalysisSnapshotReplay.test.ts",
        "tests/boundary/mcp/ghidraInventoryMcp.test.ts",
        "tests/boundary/mcp/officialTools.test.ts",
        "tests/boundary/process/processCaptureLifecycle.test.ts",
        "tests/boundary/process/windowsOutputCapture.test.ts"
      ],
      "rules": {
        "no-unsafe-finally": "off"
      }
    },
    {
      "files": [
        "arena-code/src/brains/reasoning.ts",
        "arena-code/src/harness2/context7.ts",
        "arena-code/src/harness2/harness.ts",
        "arena-code/src/visual/imageGuard.ts",
        "arena-code/src/visual/inspectionTeam.ts",
        "arena-code/src/rag/embedder.ts",
        "scripts/verify-solidity-metadata.mjs",
        "src/cutter/CutterBridgeClient.ts"
      ],
      "rules": {
        "no-useless-escape": "off",
        "no-misleading-character-class": "off"
      }
    },
    {
      "files": [
        "scripts/verify-real-kuna.mjs",
        "src/flutter/FlutterBuildProvider.ts",
        "src/frida/FridaInstrumentationManager.ts",
        "arena-code/src/rag/embedder.ts",
        "src/cutter/CutterBridgeClient.ts",
        "arena-code/src/visual/imageGuard.ts"
      ],
      "rules": {
        "unicorn/no-useless-spread": "off",
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": ["arena-code/src/loop/structuralContext.ts", "src/domain/process/processTraceSpecification.ts", "src/inspector/V8InspectorCaptureProjection.ts", "src/sqlite/SqliteDatabaseProvider.ts", "src/kuna/KunaProjectCache.ts", "src/kuna/KunaTargetCommands.ts", "src/domain/javascript/electronWrappedCallPaths.ts"],
      "rules": {
        "no-useless-escape": "off",
        "unicorn/no-new-array": "off",
        "unicorn/no-useless-spread": "off",
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["arena-code/src/tools/bash.ts", "arena-code/src/harness2/proposer.ts", "arena-code/src/sandbox/index.ts", "arena-code/src/tools/browser.ts", "arena-code/src/harness2/composer.ts", "arena-code/src/harness2/fleetProbe.ts", "arena-code/src/visual/externalEngines.ts"],
      "rules": {
        "no-useless-escape": "off",
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["tests/boundary/providers/hopper/hopperClient.externalExit.test.ts", "tests/boundary/mcp/evidenceImportCancellation.test.ts", "tests/boundary/pcap/pcapProvider.test.ts", "src/ghidra/GhidraLoadImageValues.test.ts"],
      "rules": {
        "no-this-alias": "off",
        "no-unused-expressions": "off"
      }
    },
    {
      "files": ["experiments/**/*.mjs"],
      "rules": {
        "no-constant-condition": "off"
      }
    },
    {
      "files": ["src/gdb/GdbSessionManager.ts", "src/adb/AdbProvider.ts", "src/domain/native/nativeAotPe.ts", "src/domain/javascript/javascriptSemanticMemberMutations.ts", "src/process/capture/ProcessCaptureLifecycle.ts", "src/cutter/CutterBridgeClient.ts"],
      "rules": {
        "max-lines-per-function": ["warn", { "max": 150, "skipBlankLines": true, "skipComments": true }],
        "complexity": ["warn", 30],
        "max-depth": ["warn", 6]
      }
    }
  ],
  "env": {
    "node": true,
    "es2023": true
  },
  "ignorePatterns": [
    "dist",
    "build",
    "node_modules",
    "docs/api",
    "coverage",
    ".turbo",
    ".cache",
    ".codex",
    ".devin",
    ".factory",
    "third_party"
  ]
}
