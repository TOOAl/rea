{
  "name": "arena-code",
  "version": "2.9.0",
  "description": "Claude Code 클론 — REA 분석 기반, Arena Agent + 무료 API 지원 (Hook/MCP/외부 패키지/에이전트 허브 + Harness² Self-Improving Brain H1~H5 + Fleet + Hybrid + Design Mode + RAG + Genius NL Triggers)",
  "type": "module",
  "bin": {
    "arena-code": "dist/cli.js"
  },
  "_workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"packages/*/src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"packages/*/src/**/*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:check": "node dist/cli.js --update check",
    "update:apply": "node dist/cli.js --update apply"
  },
  "keywords": [
    "agent",
    "coding",
    "claude-code",
    "arena",
    "rea",
    "mcp",
    "hooks",
    "external-agents",
    "fleet",
    "orchestration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "yoctocolors": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
