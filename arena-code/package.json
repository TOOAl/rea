{
  "name": "arena-code",
  "version": "2.23.2",
  "description": "Claude Code 클론 — REA 분석 기반, 5층+3.5게이트 v2.23.2 (인류 천재 36인·6신규·게이트 6프로필 추가)",
  "type": "module",
  "bin": {
    "arena-code": "dist/cli.js"
  },
  "_workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\" \"packages/*/src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" \"packages/*/src/**/*.{ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "update:check": "node dist/cli.js --update check",
    "update:apply": "node dist/cli.js --update apply"
  },
  "keywords": [
    "agent",
    "coding",
    "claude-code",
    "arena",
    "rea",
    "mcp",
    "hooks",
    "external-agents",
    "fleet",
    "orchestration"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "hanspell": "^1.0.1",
    "js-tiktoken": "^1.0.21",
    "tesseract.js": "^7.0.0",
    "yoctocolors": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
