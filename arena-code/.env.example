# Provider 선택: arena | openrouter | gemini | groq | ollama | anthropic
ARENA_PROVIDER=gemini
# ARENA_PROVIDER=openrouter
# ARENA_PROVIDER=arena
# ARENA_PROVIDER=ollama

# --- OpenRouter (무료 모델 추천) ---
# 발급: https://openrouter.ai/keys
# 무료 모델: deepseek/deepseek-r1:free , qwen/qwen3-coder:free , meta-llama/llama-3.3-70b:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free

# --- Google Gemini (Free Tier) ---
# 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (Free) ---
# 발급: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (로컬, 완전 무료) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# --- Anthropic (유료, Claude 정식) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Arena Agent (워크스페이스 내) ---
# Arena에서 제공하는 LLM 엔드포인트가 있다면 설정
# 예: Arena Agent의 OpenAI 호환 URL
ARENA_API_URL=
ARENA_API_KEY=
ARENA_MODEL=arena-agent

# --- 공통 ---
MAX_TURNS=20
MAX_CONTEXT_TOKENS=100000
